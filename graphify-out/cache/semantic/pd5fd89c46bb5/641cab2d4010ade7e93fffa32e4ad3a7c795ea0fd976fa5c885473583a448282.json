{"nodes": [{"id": "docs_design_system_raqim_design_foundation_review", "label": "RAQIM Design Foundation Review", "file_type": "document", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_raqim_design_foundation_review_information_architecture_philosophy", "label": "Information Architecture Philosophy (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 never states that editorial curation should always outrank algorithmic/engagement-driven sorting across the product, risking a quiet 'popular this week' feature later."}, {"id": "docs_design_system_raqim_design_foundation_review_editorial_layout_principles", "label": "Editorial Layout Principles (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 applies one undifferentiated rhythm philosophy to fundamentally different page types (checkout, editorial description, admin table, About page) and never states a resumability principle for long-form content."}, {"id": "docs_design_system_raqim_design_foundation_review_cognitive_design", "label": "Cognitive Design (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing concepts: attention budget, visual weight as a controllable variable, noise reduction as ongoing discipline, decision fatigue per journey, and progressive complexity distinct from progressive disclosure."}, {"id": "docs_design_system_raqim_design_foundation_review_product_consistency_governance", "label": "Product Consistency & Governance (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 lacks a precedence order among its own sections, so two designers can each correctly cite it to justify opposite decisions."}, {"id": "docs_design_system_raqim_design_foundation_review_luxury_interaction_philosophy", "label": "Luxury Interaction Philosophy (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinct from Motion Language: no stance on intentional friction in checkout, no philosophy of forgiveness, no anticipation/attentiveness principle."}, {"id": "docs_design_system_raqim_design_foundation_review_trust_design", "label": "Trust Design lifecycle (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 treats trust as static accumulation; review asks for a lifecycle view covering first visit, mid-purchase, failure recovery, and returning-customer trust."}, {"id": "docs_design_system_raqim_design_foundation_review_writing_system_philosophy", "label": "Writing System Philosophy (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No definition of who the English reader is, no parity rule for incomplete bilingual content, no translation-vs-transcreation stance, no mixed-script behavior."}, {"id": "docs_design_system_raqim_design_foundation_review_system_evolution_rules", "label": "System Evolution Rules (gap)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No distinction between immutable core and amendable specifics, no adoption filter for future trends, no continuity mechanism for team growth."}], "edges": [{"source": "docs_design_system_raqim_design_foundation_review", "target": "docs_design_system_raqim_design_system", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_foundation_review_information_architecture_philosophy", "target": "docs_design_system_raqim_design_system_editorial_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_foundation_review_editorial_layout_principles", "target": "docs_design_system_raqim_design_system_reading_first_experience", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_foundation_review_luxury_interaction_philosophy", "target": "docs_design_system_raqim_design_system_motion_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_foundation_review_trust_design", "target": "docs_design_system_raqim_design_system_dashboard_experience_philosophy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-FOUNDATION-REVIEW.md", "source_location": null, "weight": 1.0}], "hyperedges": []}