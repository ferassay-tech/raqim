{"nodes": [{"id": "docs_design_system_raqim_design_constitution", "label": "RAQIM Design Constitution", "file_type": "document", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_raqim_design_constitution_non_negotiable_principles", "label": "Non-Negotiable Principles (Tier 0, NNP)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable rules (NNP-1..8) that override all other tiers: reading over engagement, Arabic/RTL-first, editorial over algorithmic ordering, no manufactured urgency, one focal point, no false success states, no bilingual degradation."}, {"id": "docs_design_system_raqim_design_constitution_product_identity_constraints", "label": "Product Identity Constraints (Tier 1, PIC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks convergence toward marketplace, SaaS dashboard, generic admin panel, social feed, and CMS-clone patterns (PIC-1..10)."}, {"id": "docs_design_system_raqim_design_constitution_trust_constraints", "label": "Trust Constraints (Tier 2, TC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires unambiguous transaction confirmation, no premature success states, actionable failure messages, minimal data collection, and same-session resolution of payment failures."}, {"id": "docs_design_system_raqim_design_constitution_editorial_constraints", "label": "Editorial Constraints (Tier 3, EC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires human-authored descriptions, bilingual content parity before exposure, no promotional interstitials in reading surfaces, and human review of AI-assisted content."}, {"id": "docs_design_system_raqim_design_constitution_ux_constraints", "label": "UX Constraints (Tier 4, UXC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flows completable without forced language switch, no data loss on failed submission, accessible labels, three-step navigation ceiling, WCAG AA floor."}, {"id": "docs_design_system_raqim_design_constitution_interaction_constraints", "label": "Interaction Constraints (Tier 5, IC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No simultaneous attention-seeking animations, no autoplay by default, loading indication required, reduced-motion respected, confirmation weight proportional to reversibility."}, {"id": "docs_design_system_raqim_design_constitution_growth_constraints", "label": "Growth Constraints (Tier 6, GC)", "file_type": "rationale", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New features must be justified by reader effort reduction, editorial trust, or business support; checked against NNP/PIC before implementation; extend existing patterns before inventing new ones."}, {"id": "docs_design_system_raqim_design_constitution_decision_hierarchy", "label": "Decision Hierarchy & Conflict Resolution Algorithm", "file_type": "concept", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_raqim_design_constitution_amendment_rules", "label": "Amendment Rules (AM)", "file_type": "concept", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_raqim_design_constitution_validation_checklist", "label": "Validation Checklist (VC)", "file_type": "concept", "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_system_raqim_design_constitution", "target": "docs_design_system_raqim_design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_constitution_non_negotiable_principles", "target": "docs_design_system_raqim_design_system_brand_dna", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_constitution_product_identity_constraints", "target": "docs_design_system_raqim_design_system_editorial_identity", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/RAQIM-DESIGN-CONSTITUTION.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_raqim_design_constitution_non_negotiable_principles", "target": "docs_design_system_raqim_visual_language_motion_philosophy", "relation": "semantically_similar_to"