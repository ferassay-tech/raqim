# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already gitignored.
#
# Required only when Settings → Storage → مزوّد التخزين is set to
# "Supabase Storage". Local storage works with none of this set.

# Project URL, from Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=

# The PUBLIC anon key (never the service-role key) from the same page.
# This value ends up in the built client bundle — that's expected for the
# anon key; access control is enforced by the "library" bucket's Storage
# RLS policies, not by keeping this key secret.
VITE_SUPABASE_ANON_KEY=
