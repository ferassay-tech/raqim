# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already gitignored.
#
# Required only when Settings → Storage → مزوّد التخزين is set to
# "Supabase Storage". Local storage works with none of this set.

# Project URL, from Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=

# The PUBLIC anon key (never the service-role key) from the same page.
# This value ends up in the built client bundle — that's expected for the
# anon key; access control is enforced by the "library" bucket's Storage
# RLS policies, not by keeping this key secret.
VITE_SUPABASE_ANON_KEY=

# --- Email (api/send-download-email.ts) ---
# SERVER-SIDE ONLY — deliberately NOT prefixed VITE_. These must never be
# exposed to the client: a Resend API key grants full send-as-your-domain
# access, unlike the Supabase anon key above. Set these as plain
# Environment Variables in the Vercel project (or in a local .env for
# `vercel dev`), never in client-readable config.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Must be a sender address on a domain verified in Resend (SPF/DKIM
# configured there) — an unverified domain will fail to send or land in
# spam regardless of anything in this codebase.
RESEND_FROM_EMAIL=
